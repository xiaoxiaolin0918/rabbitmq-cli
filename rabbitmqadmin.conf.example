# Copy to %USERPROFILE%\.rabbitmqadmin.conf (TOML). Never commit real passwords.
# Docs: https://www.rabbitmq.com/docs/management-cli
# Use localhost/guest in the repo example only. Real lab host/user/pass stay on the machine.

[default]
hostname = "127.0.0.1"
port = 15672
username = "guest"
password = "guest"

# Add more [node] sections locally, for example:
# [lab]
# hostname = "127.0.0.1"
# port = 15672
# username = "guest"
# password = "guest"
